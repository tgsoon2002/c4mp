    }
    cmd_install = command 'install' {
      description 'Make this single-file binary a global command. Copies it to ~/.local/bin (Windows: %LOCALAPPDATA%\\Programs\\c4pm) and, with your consent, adds that folder to PATH. Shows the plan and asks once; without a terminal it needs --yes. Never uses sudo: for /usr/local/bin run sudo cp yourself'
      metadata {
        uid 'a002a87b-c1a7-47de-90be-9730aa2996e9'
      }
      dir = flag '--dir <folder>' {
        description 'install into this folder instead of the default'
        metadata {
          uid '15579330-b9c0-43fd-963c-850c68732c23'
        }
      }
      yes = flag '--yes' {
        description 'do it without asking'
        metadata {
          uid 'ddba4c80-b970-4454-85c7-415410862a2b'
        }
      }
      no_path = flag '--no-path' {
        description 'do not change PATH or any shell profile'
        metadata {
          uid 'e6b61855-0330-48a2-8ac3-ef445b371347'
        }
      }
    }
    cmd_uninstall = command 'uninstall' {
      description 'Remove the installed binary and the PATH block c4pm added. Removes only the file c4pm (c4pm.exe) in the install folder and the marked block in your shell profile; asks once, or use --yes'
      metadata {
        uid 'cbdb66a2-8ec2-4c59-9b27-5161ac67e425'
      }
      dir = flag '--dir <folder>' {
        description 'the folder c4pm was installed into (default: the install default)'
        metadata {
          uid '0095f72a-0533-4108-8f09-ded6c2024cda'
        }
      }
      yes = flag '--yes' {
        description 'do it without asking'
        metadata {
          uid '5c3b00c9-e9d1-4e69-b1f3-74ef42c185a0'
        }
      }
    }
    tool_find = tool 'find' {
      description 'Find functions, classes, methods and files by name. Case-insensitive substring of the name or the file path; each hit has file, lines, kind and owning component.'
      metadata {
        uid '1e27d64e-f2c8-4e3b-9345-0e839edd0133'
      }
      -> c4pm.c4pm.mcp 'served by'
      query = param 'query' {
        description 'Substring of an element name or a file path'
        metadata {
          uid 'da75f54f-dff5-4f4a-82c6-a87dc10335ab'
          type 'string'
          required 'true'
        }
      }
      kind = param 'kind' {
        description 'Only this kind'
        metadata {
          uid '64679d9c-7ebd-41ee-b78f-1db888c6be92'
          type 'string (function|class|method|file)'
        }
      }
      limit = param 'limit' {
        description 'Most hits to return'
        metadata {
          uid '5e4b7aeb-4120-4292-990b-89bf87f245d9'
          type 'integer'
        }
      }
    }
    tool_search = tool 'search' {
      description 'Search the text of the files (source, html, css, md, json, yaml, templates) for an error message or a UI label. Literal, case-insensitive by default. Each hit has file, line, text, enclosing function and owner. Skips binary files, files over 1 MB and ignored folders; the result counts hits, files searched and files skipped.'
      metadata {
        uid 'a1ba9fb6-9e20-49ee-8b15-1fefb89a40cf'
      }
      -> c4pm.c4pm.mcp 'served by'
      query = param 'query' {
        description 'Text to look for (a pattern when regex is true)'
        metadata {
          uid '32858cfe-c9b8-41df-b114-990aa88b2275'
          type 'string'
          required 'true'
        }
      }
      regex = param 'regex' {
        description 'Treat query as a regular expression'
        metadata {
          uid '157513da-49f5-4b2a-af59-a8b9b7ee5d52'
          type 'boolean'
        }
      }
      case = param 'case' {
        description 'Case-sensitive'
        metadata {
          uid '4fbe83f6-3465-46f9-9440-99079943bc2d'
          type 'boolean'
        }
      }
      ext = param 'ext' {
        description 'Only these extensions, e.g. [".html", ".css"]'
        metadata {
          uid '8d9a76c3-b701-4820-9758-c8a6f511cf41'
          type 'array<string>'
        }
      }
      max = param 'max' {
        description 'Most hits to return'
        metadata {
          uid '03469d1a-fd55-45bd-af1d-1f1a98df7491'
          type 'integer'
        }
      }
      context = param 'context' {
        description 'Lines around each hit'
        metadata {
          uid '3ab54f1d-fbc8-40f3-8550-e597c805484d'
          type 'integer'
        }
      }
    }
    tool_show = tool 'show' {
      description 'Return the source of a function, a line range or a whole file. Target is path, path#name, path#Class.method, path#L10 or path#L10-L20; only scanned source files inside the repo are shown.'
      metadata {
        uid 'b40a8373-03a9-4028-b80d-4463ffa8347e'
      }
      -> c4pm.c4pm.mcp 'served by'
      target = param 'target' {
