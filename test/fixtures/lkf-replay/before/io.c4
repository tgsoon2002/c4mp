          type 'string'
          required 'true'
        }
      }
    }
    tool_callers = tool 'callers' {
      description 'List the functions that call a function or method: {target, callers: [{name, file, line, resolved}], unresolved}. <module> is the caller of calls outside any named function. unresolved counts untraced calls of the same name elsewhere (possible callers).'
      metadata {
        uid 'd334bca8-acb5-4c62-a4f7-e6801c31db2d'
      }
