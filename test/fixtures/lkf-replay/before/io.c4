        description 'Kanban groups of a board: add, remove or order them. Run c4pm board group <command> --help for details'
        metadata {
          uid '08b370d4-a4b4-4102-a597-dd34cc57ff1d'
        }
        -> c4pm.c4pm.boards 'runs'
        add = command 'board group add' {
          description 'Add a custom group (no status). The id is made from the name. Refused for a duplicate name or id. Prints the change (dry run) and writes only with --yes'
          metadata {
            uid 'e0743b4a-e15b-41d3-a614-1b382a23e6a8'
          }
          -> c4pm.c4pm.boards 'runs'
          name = arg '<name>' {
            metadata {
