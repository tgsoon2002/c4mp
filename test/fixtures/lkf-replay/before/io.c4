        metadata {
          uid '1a206c20-6896-45ae-bc6b-15b8885ab260'
        }
        -> c4pm.c4pm.settings 'runs'
        lang = flag '--lang <ids>' {
          description 'comma-separated languages to scan: typescript, python, rust, csharp, php, cpp, swift, files (default: typescript). \'files\' lists files of other languages (java, go, ...) without reading functions; off by default; extensions: config key fileOnlyExtensions. Pass the same value to every command'
          metadata {
            uid '32e9e745-ea07-4520-885f-27b07822e8a6'
          }
        }
        ignore = flag '--ignore <patterns>' {
          description 'comma-separated repo-relative patterns to skip: folder prefix, file path, or glob (* ** ?), e.g. dist,src/gen.ts,**/*.test.ts (default: none). Also applies to .c4 discovery; a pattern that matches nothing is reported as a scan warning'
          metadata {
            uid '1891a26e-98b6-49be-a877-5d83448b7f2b'
          }
