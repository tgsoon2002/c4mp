// IO items of C4PM's own plan: the viewer screens (Map page, IO view, Own window), the CLI commands and the
// MCP tools. Moved out of architecture.c4 on 2026-11-03 (b294); same elements, same uids. Screen wireframes
// live next to this file in io/<screen fqn>.html.
model {
  extend c4pm.c4pm {
    map_page = screen 'Map page' {
      description 'The architecture view: the default page of the HTML viewer (no hash).'
