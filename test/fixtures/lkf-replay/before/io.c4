            }
          }
          board = flag '--board <id>' {
            description 'board of the group (default: the only open board)'
            metadata {
              uid '1c7eb38b-65b1-4658-9ec2-a9e56b802673'
            }
          }
          yes = flag '--yes' {
            description 'write the change; without it only the change is printed'
            metadata {
              uid '9b0339ff-7f5e-4868-9a4f-bc485057b6ea'
            }
          }
          json = flag '--json' {
            description 'print one JSON object instead of text'
