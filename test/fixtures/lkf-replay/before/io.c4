    tool_calls = tool 'calls' {
      description 'List the functions a function or method calls: {target, calls: [{name, file, line, resolved}], unresolved, external}. Only traced calls are listed (same file, imported from a repo file, method of a known class or namespace); unresolved and external calls are counted, never guessed.'
      metadata {
        uid '08c3ae70-c50d-4afc-9905-deac4069604d'
      }
      -> c4pm.c4pm.mcp 'served by'
      function = param 'function' {
