            }
          }
          yes = flag '--yes' {
            description 'write the change; without it only the change is printed'
            metadata {
              uid 'ab11028d-ce2b-4879-85dc-6fc32f802b2e'
            }
          }
          json = flag '--json' {
            description 'print one JSON object instead of text'
            metadata {
