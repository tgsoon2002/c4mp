        metadata {
          uid '7bf0642e-b046-4506-bb7a-12e04d14dd0b'
          type 'string'
          required 'true'
        }
      }
      max_lines = param 'max_lines' {
        description 'Most lines to return'
        metadata {
          uid 'bc2aade5-f175-4856-9957-7ee6227b6c32'
          type 'integer'
        }
      }
    }
    tool_outline = tool 'outline' {
      description 'List every function, class and method of one scanned file. Methods are nested under their class; each shows lines and owning component.'
      metadata {
        uid '7b925fde-379f-40f7-bb14-7fa5ab476291'
