// planned components for this folder
model {
  extend phofast.api {
    orders = component 'Order Service' {
      technology 'Node / Express'
      description 'Creates and tracks food orders'
      link ./index.ts#L7-L14 'Order routes'
      metadata {
        status   'in-progress'
        owner    'jay'
        sprint   'S15'
        priority 'high'
      }
    }
  }
}
