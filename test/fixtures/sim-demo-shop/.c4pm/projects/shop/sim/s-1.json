        "to": "a07fa683-4d65-40f4-8f80-7d0ce807503a",
        "label": "opens Product page"
      },
      "state": "cart: empty",
      "caption": "The buyer opens the product page of the Blue mug (12.00).",
      "durationSec": 4
    },
    {
      "target": "061fbf7b-3657-4dbc-8fd5-d919d0034768",
      "view": "io",
      "call": {
        "from": "ddea502b-030e-47ce-b5c1-0d9c6852b44a",
        "to": "15e1bcfb-ca64-49d5-9717-f1317dec6fb7",
        "label": "presses Add to cart"
      },
      "state": "cart: empty",
      "caption": "The buyer presses Add to cart. The Cart store of the web app takes the click.",
      "durationSec": 4
    },
    {
      "target": "e400c70c-e0cf-4475-ad94-5f9e34da83d3",
      "view": "arch",
      "call": {
        "from": "15e1bcfb-ca64-49d5-9717-f1317dec6fb7",
